# OpenAI API (may be required)
OPENAI_API_KEY=your_openai_api_key_here

# Google Drive authentication
GOOGLE_APPLICATION_CREDENTIALS=./config/credentials.json

# Google OAuth2 Configuration (optional if using service account)
# GOOGLE_CLIENT_ID=your_client_id_here
# GOOGLE_CLIENT_SECRET=your_client_secret_here
# GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Google Drive Default Folder
GOOGLE_DRIVE_DEFAULT_FOLDER_ID=your_folder_id_here

# Supabase Configuration
SUPABASE_ACCESS_TOKEN=your_supabase_access_token
# SUPABASE_ORG_ID=your_org_id  # Uncomment if you have multiple organizations
SUPABASE_PROJECT_ID=your_project_id
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_SERVICE_KEY=your_service_key
SUPABASE_URL=your_supabase_url
SUPABASE_POSTGRES_URL=postgres://postgres:your_password@db.your_project_id.supabase.co:5432/postgres

# Optional: Additional configuration
# CHROMA_PERSIST_DIRECTORY=custom_chroma_directory 